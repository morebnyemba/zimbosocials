APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Leave as UTC. Switching to a local zone requires the app, the PHP containers
# AND MariaDB to move together — some columns are stamped by the database via
# DEFAULT CURRENT_TIMESTAMP, so a partial change puts them hours apart.
APP_TIMEZONE=UTC

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Docker/compose deployment (see docker/README-deploy.md). DB_HOST is the
# compose service name, and BOTH passwords must be set or `docker compose up`
# refuses to start.
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=zimbosocials
# DB_USERNAME=zimbosocials
# DB_PASSWORD=
# DB_ROOT_PASSWORD=
# QUEUE_CONNECTION=database
# APP_PORT=8081

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=

# Paynow payment gateway
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# TEST MODE ONLY: set to your Paynow-registered merchant email to test payments
# before going live. Leave blank in production so the real customer email is used.
PAYNOW_TEST_EMAIL=

# Google Analytics 4 (leave empty to disable). Get the ID in GA Admin > Data Streams.
GOOGLE_ANALYTICS_ID=

# Shared secret for the generic payment webhook (POST /webhooks/payment).
# The caller must send X-Webhook-Signature: sha256=<hmac_sha256(raw_body, secret)>.
# Leave blank to keep the endpoint disabled (it rejects all requests when unset).
PAYMENT_WEBHOOK_SECRET=

# Google Gemini (optional) — enables AI cleanup + Shona/Ndebele translation of
# upstream services on import. Leave GEMINI_API_KEY blank to disable the feature.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Both plain-text (nudges, dashboard AI summary, marketing copy, etc.) and
# JSON (the main per-message conversation decision) replies are uncapped by
# default (0) — each prompt/schema states its own length expectation, and a
# cap cutting JSON off mid-string fails the whole request rather than
# shortening it. Set either to a positive number only if a genuinely
# runaway/repetitive response is seen in practice — GEMINI_MAX_OUTPUT_TOKENS_JSON
# is the one to reach for first, since that call runs on every inbound message.
GEMINI_MAX_OUTPUT_TOKENS=0
GEMINI_MAX_OUTPUT_TOKENS_JSON=0

# ── COST CONTROLS ──────────────────────────────────────────────────────────
# Read config/services.php for the reasoning behind each default.
#
# THINKING BUDGET (the biggest lever). Gemini 2.5 Flash thinks by default and
# decides its own budget, up to 24,576 tokens — all billed at the $2.50/M
# OUTPUT rate, and reported separately from the reply so they never showed up
# on the admin dashboard. 0 turns it off; -1 restores the old dynamic
# behaviour; 512 is the middle setting to try if accuracy suffers.
# ALWAYS re-run `php artisan whatsapp:ai-eval` after changing these.
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_BUDGET_TEXT=0

# Cheap model for calls that only write prose from facts already handed to
# them (voice fusion, nudges, moderation, copy, summaries). Output is $0.40/M
# against Flash's $2.50/M. Set it equal to GEMINI_MODEL to disable the split.
GEMINI_MODEL_LIGHT=gemini-2.5-flash-lite

# Prompt-cache TTL, in seconds. This is a STORAGE BILL: $1.00 per million
# cached tokens per hour, charged for the whole TTL whether messages arrive or
# not. It pays for itself at roughly 4+ messages per hour and loses money
# below that, so at low volume a short TTL that covers one conversation beats
# an hour of mostly-idle storage. Raise it again when traffic is steady.
GEMINI_CACHE_TTL=900

# Hard spend ceiling in USD per day, measured from the tokens actually banked
# in ai_usage (thinking included). At the ceiling the WhatsApp assistant stops
# calling Gemini and the router falls back to its deterministic menu — a
# degraded conversation, never a surprise invoice. 0 = no ceiling.
# 0.14/day is ~$0.98 over 7 days.
GEMINI_DAILY_BUDGET_USD=0.14

# Run the MAIN conversation call on the light model as well. Last big lever,
# and the only one that touches the flow/money decision — so it is off by
# default. Worth roughly $0.45 -> $0.20 a week. Turn it on ONLY with a passing
# `php artisan whatsapp:ai-eval` behind it.
GEMINI_CHAT_LIGHT=false

# Creator Monetizer panel — unlock when deposit + order spend over lookback window
# reaches this threshold (USD) within the last N days.
MONETIZER_THRESHOLD_USD=100
MONETIZER_LOOKBACK_DAYS=90


